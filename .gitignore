/target
# cargo-fuzz builds in a detached workspace under fuzz/; its build dir and
# resolved lockfile are local artifacts, never committed.
/fuzz/target
/fuzz/Cargo.lock
/fuzz/corpus
/fuzz/artifacts
**/*.rs.bk
Cargo.lock.bak
.DS_Store
.idea/
.vscode/
*.pdb

# Python build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.so
*.pyd
*.egg-info/
dist/
.venv/
build/

# Node build artifacts (index.js / index.d.ts ARE committed)
node_modules/
*.node

# WASM build artifacts
bindings/wasm/pkg/
bindings/wasm/pkg-node/

# Go: the C ABI library is staged per-platform by CI, never committed here.
bindings/go/lib/*/

# .NET build artifacts
bin/
obj/

# Java / Maven build artifacts
bindings/java/target/

# R build artifacts
bindings/r/.rlib/
bindings/r/src/*.o
bindings/r/src/*.so
bindings/r/src/*.dll
bindings/r/..Rcheck/

# Local secrets — never commit credentials.
.env
.env.*
*.key
secrets/
# Staged into src/ by configure at build time; never committed.
bindings/r/src/wickra_verify.h
bindings/r/src/libwickra_verify*
bindings/r/src/wickra_verify_abi.def
bindings/r/src/wickra-verify-c*
bindings/r/src/Makevars
bindings/r/src/symbols.rds

# Example build output. The Java example is compiled to a directory beside it by
# the command in its own header comment, and by the `examples` CI job; the
# WASM demo loads a wasm-pack build staged next to it.
examples/java/out/
examples/wasm/pkg/
